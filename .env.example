# Copy to .env and fill in. NEVER commit .env (it is git- and docker-ignored).
# Leave a key empty to run that provider in fake mode.

# --- provider keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENDART_API_KEY=

# --- provider selection: auto (real if key is set) | fake | real ---
LLM_PROVIDER=auto
EMBEDDER=auto
DART_PROVIDER=auto

# --- app ---
APP_ENV=dev
# Required when APP_ENV=production. Use a long random value.
JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://footnote:footnote@localhost:5433/footnote

# --- models / tuning (defaults shown) ---
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024
TOP_K=8
MIN_RETRIEVAL_SCORE=0.35
REVIEW_MODE=on_low_confidence

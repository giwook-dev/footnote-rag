# Copy to .env and fill in. NEVER commit .env (it is git- and docker-ignored).
# Leave a key empty to run that provider in fake mode.

# --- provider keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENDART_API_KEY=

# --- provider selection: auto (real if key is set) | fake | real ---
# LLM_PROVIDER also accepts "local": answer with Ollama running on the host (no API key).
# "auto" never picks local; set it explicitly.
LLM_PROVIDER=auto
EMBEDDER=auto
DART_PROVIDER=auto

# --- app ---
APP_ENV=dev
# Required when APP_ENV=production. Use a long random value.
JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://footnote:footnote@localhost:5433/footnote

# --- models / tuning (defaults shown) ---
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# --- local LLM (used only when LLM_PROVIDER=local; defaults shown) ---
# Ollama native API base URL. From the api container the host is host.docker.internal
# (docker-compose adds host-gateway for Linux). Running uvicorn on the host: http://localhost:11434
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
# Must be pulled first: ollama pull qwen3:14b
LOCAL_LLM_MODEL=qwen3:14b
# Context window sent as options.num_ctx. Too small = the prompt is silently truncated.
LOCAL_LLM_NUM_CTX=16384
# Output token cap (options.num_predict). Hitting it -> pending_review (truncated).
LOCAL_LLM_MAX_TOKENS=2048
# Per-request read timeout in seconds (local inference is slow) -> 504 when exceeded.
LOCAL_LLM_TIMEOUT_SECONDS=180
# Ollama "think" flag for reasoning models (qwen3 etc.). false = faster, no hidden reasoning.
LOCAL_LLM_THINK=false
# Sampling temperature (options.temperature). 0 = most deterministic.
LOCAL_LLM_TEMPERATURE=0

# --- embedding rate limits (per worker process; empty = no client-side limit) ---
# Voyage accounts WITHOUT a payment method are limited to 3 RPM / 10K TPM.
# Recommended then: EMBED_RPM_LIMIT=3, EMBED_TPM_LIMIT=9000 (free tokens are kept after
# adding a payment method). With N workers, divide both limits by N.
EMBED_RPM_LIMIT=
EMBED_TPM_LIMIT=
# Per-request estimated-token cap; the effective cap is min(this, EMBED_TPM_LIMIT).
EMBED_BATCH_MAX_TOKENS=100000
# On 429 / transient errors retry only the failed batch, up to N times, waiting
# min(BASE * 2^n, MAX) seconds + jitter; then the whole job is retried by the queue.
EMBED_BATCH_MAX_RETRIES=6
EMBED_RETRY_BASE_SECONDS=20
EMBED_RETRY_MAX_SECONDS=120
TOP_K=8
MIN_RETRIEVAL_SCORE=0.35
REVIEW_MODE=on_low_confidence
